{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "jobsearly",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jobsearly"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "jobsearly_db",
			"database_name": "jobsearly-db",
			"database_id": "7b68454a-cca9-4f70-95d1-81997878760a",
			"remote": true
		}
	]
}